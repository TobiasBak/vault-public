#!/usr/bin/env bash
# Vault checks: broken internal links, malformed recheck markers, and notes that
# are edited while still past their recheck date.
#
# Run it directly for the working tree, with --staged for the index, or install
# it as this repository's commit hook (the
# workstation secret scanner runs first and chains to it):
#   ln -sf ../../scripts/check-vault .git/hooks/pre-commit
set -uo pipefail

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

if [[ ${1:-} == --staged || ${0##*/} == pre-commit ]]; then
    git_dir=$(git rev-parse --absolute-git-dir) || exit 1
    git_index=$(git rev-parse --path-format=absolute --git-path index) || exit 1
    snapshot=$(mktemp -d "${TMPDIR:-/tmp}/vault-check.XXXXXXXX") || exit 1
    trap 'rm -rf -- "$snapshot"' EXIT
    cp -- "$git_index" "$snapshot/index" || exit 1
    mkdir "$snapshot/tree" || exit 1
    GIT_INDEX_FILE="$snapshot/index" git checkout-index --all --prefix="$snapshot/tree/" || exit 1
    GIT_DIR="$git_dir" GIT_INDEX_FILE="$snapshot/index" GIT_WORK_TREE="$snapshot/tree" \
        bash "$snapshot/tree/scripts/check-vault"
    exit $?
fi

if [[ $# -ne 0 ]]; then
    printf 'Usage: scripts/check-vault [--staged]\n' >&2
    exit 2
fi
status=0

python3 scripts/verify_links.py --vault . || status=1
python3 scripts/check-skills.py || status=1
python3 scripts/check-duplicate-authority.py || status=1
python3 scripts/check-index.py || status=1
# Expiry on its own is reported, not an error; only a malformed or duplicated
# marker exits non-zero.
python3 scripts/verify_staleness.py --vault . || status=1

# Editing a note means its facts are being restated, so they must not still be
# past their recheck date. Bumping the date without re-deriving the facts is
# the failure this check exists to catch.
today=$(date +%Y-%m-%d)
stale=()
while IFS= read -r -d '' file; do
    [ -f "$file" ] || continue
    marker=$(grep -m1 -E '^[[:space:]]*recheck-after:' "$file") || continue
    due=$(printf '%s\n' "$marker" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1) || continue
    [ -n "$due" ] || continue
    [[ "$due" < "$today" ]] && stale+=("$file (due $due)")
done < <(git diff --cached --name-only --diff-filter=d -z -- '*.md')

# A knowledge note must link to at least one other note, so a reader can
# traverse sideways instead of returning to the index. Repo-root routers link
# outward by design and are exempt.
lonely=()
while IFS= read -r -d '' file; do
    [ -f "$file" ] || continue
    case "$file" in
        skills/*|.agents/*|index.md|projects.md|AGENTS.md|README.md) continue ;;
    esac
    grep -qE '\]\([^)]*\.md' "$file" || lonely+=("$file")
done < <(git diff --cached --name-only --diff-filter=d -z -- '*.md')

if [ ${#lonely[@]} -gt 0 ]; then
    printf 'note links to no other note: %s\n' "${lonely[@]}" >&2
    printf 'Add a See also line to the notes a reader would need next.\n' >&2
    status=1
fi

if [ ${#stale[@]} -gt 0 ]; then
    printf 'stale note edited: %s\n' "${stale[@]}" >&2
    printf 'Re-derive its dated facts, then move its recheck-after date. Count from the last real\n' >&2
    printf 'check, never from the edit: a bumped date behind an unverified fact hides the rot.\n' >&2
    status=1
fi

exit $status
